NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/luxurystay
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false
SEED_ADMIN_EMAIL=admin@luxurystay.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# --- Email (booking "received" + "confirmed" emails, and "Forgot password" links) ---
# Leave SMTP_HOST empty in development: every email (booking + reset link) is printed in the server console instead.
# Gmail example: SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_SECURE=false  SMTP_USER=you@gmail.com  SMTP_PASS=<16-character Google App Password>
# In production you MUST set these, otherwise no reset emails are sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=LuxuryStay <no-reply@yourdomain.com>
